// LogiLink 입고 — 기준정보 스키마
// 근거: 01. 프로세스/01-입고 업무프로세스 정의서_v1.4.md (9장 ERD 반영 필요, D2·D7·D19, O2)
// 테이블명은 정의서 ERD 명명(TB_*)을 소문자로 따른다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 업무 주체 역할 (정의서 1·2장)
enum UserRole {
  SHIPPER_STAFF // 화주사 담당자 (Web)
  SHIPPER_LOADER // 화주사 상차담당 (PDA)
  TPL_ADMIN // 3PL 관리자 (Web)
  TPL_OPERATOR // 3PL 운영담당 (Web)
  TPL_INSPECTOR // 3PL 입고검수자 (PDA)
}

/// 로그인 시도 결과 (로그인 이력)
enum LoginResult {
  SUCCESS // 성공
  FAIL // 실패 (아이디 없음·비밀번호 불일치)
  LOCKED // 잠금 (이번 실패로 잠김 또는 잠긴 계정 시도)
  BLOCKED_INACTIVE // 차단: 사용 안 함 계정
  BLOCKED_PDA // 차단: PDA 전용 계정의 Web 로그인
}

enum ItemUnit {
  EA
  BOX
  PLT
}

/// 보관 온도대
enum StorageTemp {
  ROOM // 상온
  CHILLED // 냉장
  FROZEN // 냉동
}

/// 품목 별칭 출처
enum AliasSource {
  MANUAL // 3PL 직접 등록
  REQUEST // 품목 등록 요청의 원래 품목명
  MATCH // AI·엑셀 판독 라인을 사용자가 매칭
}

enum HolidayKind {
  PUBLIC // 공휴일
  CENTER // 센터 휴무
}

/// 휴무일 출처
enum HolidaySource {
  API // 공공데이터(한국천문연구원 특일 정보)에서 불러옴
  MANUAL // 직접 등록
}

/// 품목 등록 요청 상태
enum ItemRequestStatus {
  WAITING // 등록대기
  REJECTED // 반려 (화주사 수정 중)
  REGISTERED // 등록완료
}

/// 요청 원본
enum ItemRequestSource {
  DIRECT // 직접 입력
  EXCEL // 엑셀 업로드 미매칭
  AI // 이미지 AI 판독 미매칭
  ITEM_EXCEL // 품목 엑셀 일괄 요청
}

enum ItemRequestAction {
  REQUEST // 최초 요청
  RESUBMIT // 반려 후 재요청
  REGISTER // 3PL 등록
  REJECT // 3PL 반려
}

/// 센터 — 회사(3PL 운영 법인) 1곳에 속하고 N개를 관리한다. 삭제하지 않고 사용 안 함으로 둔다
model Center {
  id             Int      @id @default(autoincrement())
  companyId      Int      @default(1) @map("company_id")
  /// 영문 대문자·숫자 3~5자, 등록 후 수정 불가
  code           String   @unique @map("center_cd") @db.VarChar(5)
  name           String   @unique @map("center_nm") @db.VarChar(100)
  zipCode        String   @map("zip_code") @db.VarChar(5)
  addr1          String   @db.VarChar(200)
  addr2          String   @db.VarChar(100)
  inboundTel     String   @map("inbound_tel") @db.VarChar(15)
  managerUserId  Int?     @map("manager_user_id")
  /// 일마감 예정 시각 HH:mm (센터마다 다름)
  dailyCloseTime String   @map("daily_close_time") @db.VarChar(5)
  /// 업무일 시작 시각 HH:mm — 이 시각부터 다음 날 이 시각 전까지를 하루 업무일로 센다 (2026-11-11 Sol 결정, 기본 06:00)
  businessDayStart String @default("06:00") @map("business_day_start") @db.VarChar(5)
  /// 기한경과 취소 유예(영업일) — 승인 전 입고예정은 입고예정일 + 이 영업일 수가 지난 날의 일마감 때 취소 대상 (2026-11-11 Sol 결정, 기본 1)
  expireGraceDays  Int    @default(1) @map("expire_grace_days")
  /// 정기 휴무 요일 (0 일 ~ 6 토) — 영업일 계산에서 뺀다. 기본 없음: 토·일을 쉬는 날로 가정하지 않는다 (2026-11-11 Sol)
  weeklyOffDays    Int[]  @default([]) @map("weekly_off_days")
  isActive       Boolean  @default(true) @map("use_yn")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String   @map("created_by") @db.VarChar(50)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String   @map("updated_by") @db.VarChar(50)

  company      Company        @relation(fields: [companyId], references: [id])
  manager      User?          @relation("CenterManager", fields: [managerUserId], references: [id])
  users        User[]         @relation("CenterUsers")
  defaultUsers User[]         @relation("UserDefaultCenter")
  holidays     Holiday[]
  plans        InboundPlan[]
  asns         Asn[]
  loads        Load[]
  rcvs         Rcv[]
  clientLinks  ClientCenter[]

  @@map("tb_center")
}

/// 화주사 — ASN·상차 사용 여부 같은 선택 설정은 두지 않는다 (D7)
model Client {
  id              Int       @id @default(autoincrement())
  /// 영문 대문자 2자 + 순번 2자 (예: DO01). 다른 데이터의 프리픽스로 쓰므로 등록 후 수정 불가, 한 번 쓴 코드는 재사용하지 않는다
  code            String    @unique @db.VarChar(4)
  name            String    @db.VarChar(50)
  /// 상차지시서·상차확인서 발송인 정보 (법인)
  bizNo           String    @map("biz_no") @db.VarChar(12)
  ceoName         String    @map("ceo_nm") @db.VarChar(20)
  zipCode         String    @map("zip_code") @db.VarChar(5)
  addr1           String    @db.VarChar(200)
  addr2           String    @db.VarChar(100)
  tel             String?   @db.VarChar(15)
  email           String?   @db.VarChar(100)
  /// 화주사 담당자 — 시스템 사용자와 별도 입력
  contactName     String    @map("contact_nm") @db.VarChar(20)
  contactTel      String    @map("contact_tel") @db.VarChar(15)
  contactEmail    String?   @map("contact_email") @db.VarChar(100)
  /// 3PL 담당 운영자 (이용 센터 소속 3PL 관리자·운영담당)
  managerUserId   Int       @map("manager_user_id")
  contractStartDt DateTime  @map("contract_start_dt") @db.Date
  contractEndDt   DateTime? @map("contract_end_dt") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.VarChar(50)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String    @map("updated_by") @db.VarChar(50)

  manager      User           @relation("ClientManager", fields: [managerUserId], references: [id])
  centers      ClientCenter[]
  items        Item[]
  itemRequests ItemRequest[]
  plans        InboundPlan[]
  planAiReads  PlanAiRead[]
  asns         Asn[]
  loads        Load[]
  rcvs         Rcv[]
  users        User[]

  @@map("tb_client")
}

/// 화주사 이용 센터 (화주사 : 센터 = N : M)
model ClientCenter {
  id         Int      @id @default(autoincrement())
  clientId   Int      @map("client_id")
  centerCode String   @map("center_cd") @db.VarChar(5)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String   @map("created_by") @db.VarChar(50)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  center Center @relation(fields: [centerCode], references: [code])

  @@unique([clientId, centerCode])
  @@index([centerCode])
  @@map("tb_client_center")
}

/// 품목 마스터 — AI·엑셀 매칭과 PDA 바코드 스캔의 기준 (D2)
/// 수량의 기준은 baseUnit(가장 작은 단위)이고, 다른 단위는 tb_item_uom의 환산 수량으로 바꾼다.
model Item {
  id            Int         @id @default(autoincrement())
  clientId      Int         @map("client_id")
  /// 품목코드 — 시스템 채번 {화주사코드}-{순번 5자리} (2026-11-06 Sol 결정), 등록 후 변경 불가
  code          String      @db.VarChar(40)
  /// 화주사 품목코드 — 화주사가 자기 시스템에서 쓰는 코드(선택). 같은 화주사 안에서 유일, 엑셀·AI 판독 매칭에 사용
  clientCode    String?     @map("client_item_code") @db.VarChar(40)
  name          String      @db.VarChar(200)
  baseUnit      ItemUnit    @map("base_unit")
  storageTemp   StorageTemp @map("storage_temp")
  /// 소비기한 관리 품목이면 입고예정에 소비기한 입력 필수, 검수 시 실물과 다르면 현장 입력
  expiryManaged Boolean     @default(false) @map("expiry_managed")
  /// 로트 관리 품목이면 입고예정에 로트 입력 필수, 검수 시 실물과 다르면 현장 입력
  lotManaged    Boolean     @default(false) @map("lot_managed")
  isActive      Boolean     @default(true) @map("is_active")
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String      @map("created_by") @db.VarChar(50)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy     String      @map("updated_by") @db.VarChar(50)

  client      Client            @relation(fields: [clientId], references: [id])
  uoms        ItemUom[]
  barcodes    ItemBarcode[]
  aliases     ItemAlias[]
  fromRequest ItemRequest?
  planLines   InboundPlanLine[]
  asnLines    AsnLine[]
  loadLines   LoadLine[]
  loadInputs  LoadInput[]
  rcvLines    RcvLine[]
  rcvInputs   RcvInput[]

  @@unique([clientId, code])
  @@unique([clientId, clientCode])
  @@map("tb_item")
}

/// 품목 단위 환산 — 기준 단위 행은 qty = 1
model ItemUom {
  id     Int      @id @default(autoincrement())
  itemId Int      @map("item_id")
  unit   ItemUnit
  /// 이 단위 1개 = 기준 단위 qty개
  qty    Int

  item     Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  barcodes ItemBarcode[]

  @@unique([itemId, unit])
  @@map("tb_item_uom")
}

/// 품목 바코드 — 단위별로 여러 개. 같은 화주사 안에서 바코드는 하나의 품목·단위만 가리킨다
model ItemBarcode {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  clientId  Int      @map("client_id")
  unit      ItemUnit
  barcode   String   @db.VarChar(40)
  /// 대표 바코드 (품목당 1개)
  isPrimary Boolean  @default(false) @map("is_primary")

  item Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uom  ItemUom @relation(fields: [itemId, unit], references: [itemId, unit])

  @@unique([clientId, barcode])
  @@index([itemId])
  @@map("tb_item_barcode")
}

/// 품목 별칭 — AI 판독·엑셀 품목명을 마스터 품목에 자동 매칭하는 데 쓴다 (D2)
model ItemAlias {
  id         Int         @id @default(autoincrement())
  itemId     Int         @map("item_id")
  clientId   Int         @map("client_id")
  alias      String      @db.VarChar(200)
  /// 공백 제거·소문자로 맞춘 비교용 값
  normalized String      @db.VarChar(200)
  source     AliasSource @default(MANUAL)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String      @map("created_by") @db.VarChar(50)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([clientId, normalized])
  @@map("tb_item_alias")
}

/// 품목 등록 요청 — 화주사 요청 → 3PL 검토 후 등록/반려. 3PL은 값을 고쳐 등록할 수 있다.
model ItemRequest {
  id               Int               @id @default(autoincrement())
  requestNo        String            @unique @map("request_no") @db.VarChar(20)
  clientId         Int               @map("client_id")
  /// 화주사 품목코드(선택) — 품목코드는 3PL이 등록할 때 시스템이 채번한다
  clientCode       String?           @map("client_item_code") @db.VarChar(40)
  itemName         String            @map("item_name") @db.VarChar(200)
  unit             ItemUnit
  barcode          String            @db.VarChar(40)
  source           ItemRequestSource
  /// 화주사가 함께 보낸 보관 온도대·소비기한·로트 관리 여부 (없으면 3PL이 등록 시 정함)
  storageTemp      StorageTemp?      @map("storage_temp")
  expiryManaged    Boolean?          @map("expiry_managed")
  lotManaged       Boolean?          @map("lot_managed")
  /// 원본 판독값·엑셀 원문 등 참고 내용
  sourceNote       String?           @map("source_note") @db.VarChar(500)
  status           ItemRequestStatus @default(WAITING)
  version          Int               @default(1)
  resubmitCount    Int               @default(0) @map("resubmit_count")
  requestedBy      String            @map("requested_by") @db.VarChar(50)
  requestedAt      DateTime          @default(now()) @map("requested_at") @db.Timestamptz(3)
  processedBy      String?           @map("processed_by") @db.VarChar(50)
  processedAt      DateTime?         @map("processed_at") @db.Timestamptz(3)
  rejectReasonCode String?           @map("reject_reason_cd") @db.VarChar(20)
  rejectReasonText String?           @map("reject_reason_text") @db.VarChar(500)
  itemId           Int?              @unique @map("item_id")

  client    Client               @relation(fields: [clientId], references: [id])
  item      Item?                @relation(fields: [itemId], references: [id])
  histories ItemRequestHistory[]

  @@index([status])
  @@map("tb_item_req")
}

/// 품목 등록 요청 처리 이력 (Append-only)
model ItemRequestHistory {
  id         Int               @id @default(autoincrement())
  requestId  Int               @map("request_id")
  action     ItemRequestAction
  actor      String            @db.VarChar(50)
  /// "오늘 내가 처리한 건" 조회용
  actorId    Int?              @map("actor_id")
  at         DateTime          @default(now()) @db.Timestamptz(3)
  reasonCode String?           @map("reason_cd") @db.VarChar(20)
  reasonText String?           @map("reason_text") @db.VarChar(500)
  memo       String?           @db.VarChar(500)

  request ItemRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@index([actorId, action, at])
  @@map("tb_item_req_his")
}

/// 공통코드 그룹 — 사유 코드 그룹 (D19, ERD TB_COMMON_CODE)
model CodeGroup {
  code        String  @id @db.VarChar(30)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(300)
  /// 정의서에서 값까지 확정된 그룹이면 true, 임시안이면 false(미확정)
  confirmed   Boolean @default(false)
  sortOrder   Int     @default(0) @map("sort_order")

  codes CommonCode[]

  @@map("tb_code_group")
}

model CommonCode {
  id           Int      @id @default(autoincrement())
  groupCode    String   @map("group_code") @db.VarChar(30)
  code         String   @db.VarChar(20)
  name         String   @db.VarChar(100)
  sortOrder    Int      @default(0) @map("sort_order")
  /// "기타"처럼 고르면 상세 내용 입력이 필수인 코드
  requiresText Boolean  @default(false) @map("requires_text")
  isActive     Boolean  @default(true) @map("is_active")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String   @map("created_by") @db.VarChar(50)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy    String   @map("updated_by") @db.VarChar(50)

  group CodeGroup @relation(fields: [groupCode], references: [code])

  @@unique([groupCode, code])
  @@map("tb_common_code")
}

/// 사용자 — 화주사 역할은 화주사, 3PL 역할은 센터에 소속 (DB 체크 제약으로도 보장)
/// 한 사람이 역할을 여러 개 가질 수 있다(작은 화주사·센터). 단 3PL 역할과 화주사 역할은 섞지 않는다
model User {
  id              Int        @id @default(autoincrement())
  loginId         String     @unique @map("login_id") @db.VarChar(50)
  name            String     @db.VarChar(50)
  roles           UserRole[]
  clientId        Int?       @map("client_id")
  centerId        Int?       @map("center_id")
  /// 화주사 사용자의 기본 센터 — 입고예정 등록에서 처음 고른 센터 (그 화주사의 이용 센터 중 하나, 2026-11-04 Sol)
  defaultCenterId Int?       @map("default_center_id")
  isActive        Boolean    @default(true) @map("is_active")
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String     @map("created_by") @db.VarChar(50)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String     @map("updated_by") @db.VarChar(50)

  /// 로그인 — 비밀번호 해시(scrypt), 초기화 후 첫 로그인 변경 강제, 연속 실패·잠금
  passwordHash String?   @map("password_hash") @db.VarChar(200)
  mustChangePw Boolean   @default(false) @map("must_change_pw")
  failCount    Int       @default(0) @map("fail_count")
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(3)
  pwChangedAt  DateTime? @map("pw_changed_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)

  client         Client?   @relation(fields: [clientId], references: [id])
  center         Center?   @relation("CenterUsers", fields: [centerId], references: [id])
  defaultCenter  Center?   @relation("UserDefaultCenter", fields: [defaultCenterId], references: [id], onDelete: SetNull)
  managedCenters Center[]  @relation("CenterManager")
  managedClients Client[]  @relation("ClientManager")
  sessions       Session[]

  @@map("tb_user")
}

/// 로그인 세션 — id는 쿠키 토큰의 HMAC(AUTH_SECRET). 행을 지우면 즉시 로그아웃된다
model Session {
  id        String   @id @db.VarChar(64)
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ip        String?  @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tb_session")
}

/// 로그인 이력 (Append-only) — 조회 화면은 추후
model LoginLog {
  id         BigInt      @id @default(autoincrement())
  at         DateTime    @default(now()) @db.Timestamptz(3)
  /// 입력한 아이디 그대로
  loginInput String      @map("login_input") @db.VarChar(100)
  /// 입력한 아이디가 사용자와 맞으면 연결
  userId     Int?        @map("user_id")
  ip         String?     @db.VarChar(64)
  result     LoginResult
  /// 상세 사유 (비밀번호 불일치, 5회 실패로 잠금 등)
  reason     String?     @db.VarChar(100)

  @@index([at])
  @@index([userId])
  @@map("tb_login_log")
}

/// 운영 설정 (O2 미종결 알림 기준 경과일 등)
model Setting {
  key         String   @id @db.VarChar(50)
  label       String   @db.VarChar(100)
  value       String   @db.VarChar(200)
  /// INT: 정수(min~max) / TIME: HH:MM
  valueType   String   @default("INT") @map("value_type") @db.VarChar(10)
  /// 값 단위 표시 (예: 일)
  unit        String?  @db.VarChar(20)
  minValue    Int?     @map("min_value")
  maxValue    Int?     @map("max_value")
  description String?  @db.VarChar(300)
  version     Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String   @map("updated_by") @db.VarChar(50)

  @@map("tb_setting")
}

/// 회사 정보 (3PL 운영 법인, 1건) — 3PL이 발행하는 출력물 머리글에 쓴다
model Company {
  id        Int      @id @default(1)
  name      String   @db.VarChar(50)
  bizNo     String   @map("biz_no") @db.VarChar(12)
  ceoName   String   @map("ceo_name") @db.VarChar(20)
  zipCode   String   @map("zip_code") @db.VarChar(5)
  addr1     String   @db.VarChar(200)
  addr2     String   @db.VarChar(100)
  phone     String?  @db.VarChar(15)
  email     String?  @db.VarChar(100)
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String   @map("updated_by") @db.VarChar(50)

  centers Center[]

  @@map("tb_company")
}

/// 휴무일 — 입고예정일 D-day·기한 지남·기한경과 계산 때 영업일에서 뺀다
model Holiday {
  id        Int           @id @default(autoincrement())
  centerId  Int           @map("center_id")
  date      DateTime      @db.Date
  name      String        @db.VarChar(100)
  kind      HolidayKind
  source    HolidaySource @default(MANUAL)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String        @map("created_by") @db.VarChar(50)

  center Center @relation(fields: [centerId], references: [id])

  @@unique([centerId, date])
  @@map("tb_holiday")
}

/// 변경 이력 — 정의서 "모든 원본 테이블에 _HIS 이력" 요구를 기준정보에서는 공통 이력 한 테이블로 처리
model ChangeLog {
  id        BigInt   @id @default(autoincrement())
  tableName String   @map("table_name") @db.VarChar(40)
  recordKey String   @map("record_key") @db.VarChar(60)
  action    String   @db.VarChar(20)
  before    Json?
  after     Json?
  actor     String   @db.VarChar(50)
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([tableName, recordKey])
  @@map("tb_change_log")
}

/**
 * ═══════════════ 입고예정 (정의서 ①② · 4-1 · 9장 TB_INB_PLAN_*) ═══════════════
 */

/// 입고예정 상태 — 정의서 4-1. 표시명은 src/domain/plan-status.ts
enum PlanStatus {
  WAITING // 승인대기
  REJECTED // 반려
  APPROVED // 승인
  PARTIAL // 부분입고
  COMPLETED // 입고완료
  CLOSED // 종결
  CANCELED // 취소
}

/// 입고예정 등록 방식 (정의서 ①)
enum PlanInputMethod {
  DIRECT // 직접 입력
  EXCEL // 엑셀 업로드
  AI_IMAGE // 이미지 AI 판독
}

/// 입고예정 처리 이력 행위
enum PlanAction {
  CREATE // 최초 저장
  UPDATE // 수정 저장 (승인대기)
  RESUBMIT // 반려 후 재저장 (차수 +1)
  APPROVE // 3PL 승인
  REJECT // 3PL 반려
  CANCEL // 화주사 취소
  CANCEL_APPROVED // 3PL 승인 건 취소
  EXPIRE_CANCEL // 일마감 기한경과 취소
  CLOSE // 3PL 잔량 종결
  RECEIVE // 입고검수 확정 — 자동 배분 (부분입고·입고완료)
}

/// 입고예정 헤더 (TB_INB_PLAN_H) — 화주사·센터·입고예정일 1건 단위
model InboundPlan {
  id                 Int             @id @default(autoincrement())
  /// IP-YYYYMMDD-NNNN (첫 저장일 기준 일련번호)
  planNo             String          @unique @map("plan_no") @db.VarChar(20)
  clientId           Int             @map("client_id")
  centerId           Int             @map("center_id")
  planDate           DateTime        @map("plan_dt") @db.Date
  status             PlanStatus      @default(WAITING)
  inputMethod        PlanInputMethod @map("input_method")
  memo               String?         @db.VarChar(500)
  /// 동시성 제어용 — 저장할 때마다 +1 (승인·반려 시점 비교, D1)
  version            Int             @default(1)
  /// 업무 회차 — 반려 후 재저장할 때만 +1 (D6)
  revisionNo         Int             @default(1) @map("revision_no")
  approvedRevisionNo Int?            @map("approved_revision_no")
  approvedAt         DateTime?       @map("approved_at") @db.Timestamptz(3)
  approvedBy         String?         @map("approved_by") @db.VarChar(50)
  cancelReasonCode   String?         @map("cancel_reason_cd") @db.VarChar(20)
  cancelReasonText   String?         @map("cancel_reason_text") @db.VarChar(500)
  canceledAt         DateTime?       @map("canceled_at") @db.Timestamptz(3)
  canceledBy         String?         @map("canceled_by") @db.VarChar(50)
  closeReasonCode    String?         @map("close_reason_cd") @db.VarChar(20)
  closeReasonText    String?         @map("close_reason_text") @db.VarChar(500)
  closedAt           DateTime?       @map("close_dt") @db.Timestamptz(3)
  closedBy           String?         @map("close_user") @db.VarChar(50)
  /// 화주사 "잔량 종결 요청" 메모 (종결은 3PL만)
  closeReqMemo       String?         @map("close_req_memo") @db.VarChar(500)
  /// 화주사 최종 저장 (목록의 "최종 저장")
  savedAt            DateTime        @default(now()) @map("saved_at") @db.Timestamptz(3)
  savedBy            String          @map("saved_by") @db.VarChar(50)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String          @map("created_by") @db.VarChar(50)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String          @map("updated_by") @db.VarChar(50)

  client    Client               @relation(fields: [clientId], references: [id])
  center    Center               @relation(fields: [centerId], references: [id])
  lines     InboundPlanLine[]
  rejects   InboundPlanReject[]
  histories InboundPlanHistory[]
  aiReads   PlanAiRead[]
  asnLines  AsnLine[]

  @@index([status, centerId])
  @@index([clientId, status])
  @@map("tb_inb_plan_h")
}

/// 입고예정 라인 (TB_INB_PLAN_D) — 승인 전에는 화주사 저장 때 통째로 다시 쓴다
model InboundPlanLine {
  id         Int       @id @default(autoincrement())
  planId     Int       @map("plan_id")
  lineNo     Int       @map("line_no")
  itemId     Int       @map("item_id")
  /// 입력 단위 (품목에 등록된 단위 중 하나)
  unit       ItemUnit
  qty        Int
  /// 기준 단위 환산 수량 — 검수·배분·잔량 계산 기준
  baseQty    Int       @map("base_qty")
  /// 소비기한·로트 관리 품목만 (U10)
  expiryDate DateTime? @map("expiry_dt") @db.Date
  lotNo      String?   @map("lot_no") @db.VarChar(40)
  /// 이하 기준 단위 누계 (검수·배분 단계에서 채움)
  rcvQty     Int       @default(0) @map("rcv_qty")
  returnQty  Int       @default(0) @map("return_qty")
  diffQty    Int       @default(0) @map("diff_qty")
  closeQty   Int       @default(0) @map("close_qty")

  plan     InboundPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  item     Item        @relation(fields: [itemId], references: [id])
  asnLines AsnLine[]
  rcvAllocs RcvAlloc[]

  @@unique([planId, lineNo])
  @@index([itemId])
  @@map("tb_inb_plan_d")
}

/// 반려본 스냅샷 헤더 (TB_INB_PLAN_REJ_H) — Append-only (DB 트리거로 수정·삭제 차단)
model InboundPlanReject {
  id         Int      @id @default(autoincrement())
  planId     Int      @map("plan_id")
  revisionNo Int      @map("revision_no")
  version    Int
  planDate   DateTime @map("plan_dt") @db.Date
  memo       String?  @db.VarChar(500)
  reasonCode String   @map("reason_cd") @db.VarChar(20)
  reasonName String   @map("reason_nm") @db.VarChar(100)
  reasonText String?  @map("reason_text") @db.VarChar(500)
  rejectedBy String   @map("rejected_by") @db.VarChar(50)
  rejectedAt DateTime @default(now()) @map("rejected_at") @db.Timestamptz(3)

  plan  InboundPlan             @relation(fields: [planId], references: [id])
  lines InboundPlanRejectLine[]

  @@unique([planId, revisionNo])
  @@map("tb_inb_plan_rej_h")
}

/// 반려본 스냅샷 라인 (TB_INB_PLAN_REJ_D) — 품목코드·이름도 당시 값으로 보관
model InboundPlanRejectLine {
  id         Int       @id @default(autoincrement())
  rejectId   Int       @map("reject_id")
  lineNo     Int       @map("line_no")
  itemId     Int       @map("item_id")
  itemCode   String    @map("item_code") @db.VarChar(40)
  itemName   String    @map("item_name") @db.VarChar(200)
  unit       ItemUnit
  qty        Int
  baseQty    Int       @map("base_qty")
  expiryDate DateTime? @map("expiry_dt") @db.Date
  lotNo      String?   @map("lot_no") @db.VarChar(40)

  reject InboundPlanReject @relation(fields: [rejectId], references: [id])

  @@unique([rejectId, lineNo])
  @@map("tb_inb_plan_rej_d")
}

/// 입고예정 처리 이력 (전표 이력 — 기준정보의 tb_change_log와 별도)
model InboundPlanHistory {
  id         BigInt     @id @default(autoincrement())
  planId     Int        @map("plan_id")
  action     PlanAction
  version    Int
  revisionNo Int        @map("revision_no")
  actor      String     @db.VarChar(50)
  /// "오늘 내가 처리한 건" 조회용
  actorId    Int?       @map("actor_id")
  at         DateTime   @default(now()) @db.Timestamptz(3)
  reasonCode String?    @map("reason_cd") @db.VarChar(20)
  reasonName String?    @map("reason_nm") @db.VarChar(100)
  reasonText String?    @map("reason_text") @db.VarChar(500)

  plan InboundPlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([actorId, action, at])
  @@map("tb_inb_plan_his")
}

/// 입고예정 AI 판독 작업 — 정의서 ①: 판독 결과는 저장 전까지 초안. AI 원본 결과와 사용자 수정 내용을 모두 보존한다.
/// 원본 이미지 파일은 저장소가 정해질 때까지 보관하지 않고 파일 이름만 남긴다 (개발 후 처리 목록: 원본 문서 저장소)
model PlanAiRead {
  id         Int       @id @default(autoincrement())
  clientId   Int       @map("client_id")
  /// 이 판독으로 저장한 입고예정 (저장 전·버린 판독은 null)
  planId     Int?      @map("plan_id")
  fileNames  String[]  @map("file_names")
  /// 판독 모델 ID. 예시 판독(API 키 없음)이면 "example"
  model      String    @db.VarChar(40)
  isExample  Boolean   @default(false) @map("is_example")
  /// AI가 돌려준 원본 결과 그대로
  rawResult  Json      @map("raw_result")
  /// 사용자가 매칭·수정해 저장한 라인
  finalLines Json?     @map("final_lines")
  createdBy  String    @map("created_by") @db.VarChar(50)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  savedAt    DateTime? @map("saved_at") @db.Timestamptz(3)

  client Client       @relation(fields: [clientId], references: [id])
  plan   InboundPlan? @relation(fields: [planId], references: [id])

  @@index([clientId, createdAt])
  @@index([planId])
  @@map("tb_inb_plan_ai_read")
}

/**
 * ═════════ ASN · 상차지시서 (정의서 ③ · 4-2 · C4 · D7~D9) ═════════
 */

/// ASN 상태 — 정의서 4-2. 표시명은 src/domain/asn-status.ts
enum AsnStatus {
  REGISTERED // 등록 (상차지시서 발행, 상차 시작 전)
  LOADING // 상차중
  LOADED // 상차완료
  RECEIVED // 입고완료
  CANCELED // 취소 (상차 시작 전까지만)
}

/// 상차지시서 상태 — 정의서 4-2 (ASN 1:1)
enum LoadOrderStatus {
  ISSUED // 발행
  LOADED // 상차완료
  INSPECTED // 검수완료
  CANCELED // 취소
}

/// ASN 처리 이력 행위
enum AsnAction {
  CREATE // 등록 (상차지시서 발행)
  CANCEL // 화주사 취소
  LOAD_START // 상차 시작 (첫 상차 입력)
  LOAD_COMPLETE // 상차완료 (상차확인서 발행)
  RECEIVE // 입고검수 확정 (입고완료)
  LOAD_REOPEN // 상차 재개 (정의서 v1.5 D20, 상차완료 → 상차중)
}

/// ASN 헤더 (TB_ASN_H) — 차량 1대 단위. 입고예정번호를 두지 않고 라인이 입고예정 라인을 가리킨다 (D9)
/// 차량 기준정보는 두지 않고 차량번호를 직접 적는다 (2026-11-04 Sol, H1). 한 화주사·한 센터의 입고예정만 담는다
model Asn {
  id               Int       @id @default(autoincrement())
  /// ASN-YYYYMMDD-NNNN (등록일 기준 일련번호)
  asnNo            String    @unique @map("asn_no") @db.VarChar(20)
  clientId         Int       @map("client_id")
  centerId         Int       @map("center_id")
  /// 출고일 (상차하는 날) — 입고예정일과 달라도 된다 (D8). 상차 입력의 "당일 ASN" 기준
  shipDate         DateTime  @map("ship_dt") @db.Date
  /// 공백을 뺀 차량번호 (예: 12가3456)
  vehicleNo        String    @map("vehicle_no") @db.VarChar(20)
  driverName       String?   @map("driver_nm") @db.VarChar(20)
  driverTel        String?   @map("driver_tel") @db.VarChar(15)
  memo             String?   @db.VarChar(500)
  status           AsnStatus @default(REGISTERED)
  version          Int       @default(1)
  cancelReasonCode String?   @map("cancel_reason_cd") @db.VarChar(20)
  cancelReasonText String?   @map("cancel_reason_text") @db.VarChar(500)
  canceledAt       DateTime? @map("canceled_at") @db.Timestamptz(3)
  canceledBy       String?   @map("canceled_by") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String    @map("created_by") @db.VarChar(50)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String    @map("updated_by") @db.VarChar(50)

  client    Client       @relation(fields: [clientId], references: [id])
  center    Center       @relation(fields: [centerId], references: [id])
  lines     AsnLine[]
  loadOrder LoadOrder?
  load      Load?
  histories AsnHistory[]

  @@index([clientId, status])
  @@index([centerId, shipDate])
  @@index([vehicleNo])
  @@map("tb_asn_h")
}

/// ASN 라인 (TB_ASN_D) — 입고예정 라인 하나에서 이 차량에 싣는 지시수량 (C4: 라인별 분배 합계 ≤ 승인 잔량)
model AsnLine {
  id         Int      @id @default(autoincrement())
  asnId      Int      @map("asn_id")
  lineNo     Int      @map("line_no")
  planId     Int      @map("plan_id")
  planLineId Int      @map("plan_line_id")
  itemId     Int      @map("item_id")
  /// 입고예정 라인의 단위로 지시한다
  unit       ItemUnit
  qty        Int
  /// 기준 단위 환산 지시수량 — 분배 잔량 계산 기준
  baseQty    Int      @map("base_qty")

  asn      Asn             @relation(fields: [asnId], references: [id], onDelete: Cascade)
  plan     InboundPlan     @relation(fields: [planId], references: [id])
  planLine InboundPlanLine @relation(fields: [planLineId], references: [id])
  item     Item            @relation(fields: [itemId], references: [id])
  rcvAllocs RcvAlloc[]

  @@unique([asnId, lineNo])
  @@index([planLineId])
  @@index([planId])
  @@index([itemId])
  @@map("tb_asn_d")
}

/// 상차지시서 (TB_LOAD_ORDER) — ASN 저장과 동시에 발행 (ASN 1:1). 바코드 = 지시서 번호
model LoadOrder {
  id        Int             @id @default(autoincrement())
  /// LO-YYYYMMDD-NNNN
  orderNo   String          @unique @map("order_no") @db.VarChar(20)
  asnId     Int             @unique @map("asn_id")
  status    LoadOrderStatus @default(ISSUED)
  issuedAt  DateTime        @default(now()) @map("issued_at") @db.Timestamptz(3)
  issuedBy  String          @map("issued_by") @db.VarChar(50)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  asn  Asn   @relation(fields: [asnId], references: [id], onDelete: Cascade)
  load Load?

  @@map("tb_load_order")
}

/// ASN 처리 이력 (TB_ASN_HIS)
model AsnHistory {
  id         Int       @id @default(autoincrement())
  asnId      Int       @map("asn_id")
  action     AsnAction
  version    Int
  actor      String    @db.VarChar(50)
  actorId    Int?      @map("actor_id")
  at         DateTime  @default(now()) @db.Timestamptz(3)
  reasonCode String?   @map("reason_cd") @db.VarChar(20)
  reasonName String?   @map("reason_nm") @db.VarChar(100)
  reasonText String?   @map("reason_text") @db.VarChar(500)

  asn Asn @relation(fields: [asnId], references: [id])

  @@index([asnId])
  @@map("tb_asn_his")
}

/**
 * ═════════ 상차등록 (정의서 ④ · 4-2 · 9장 · C5 · C6 · D10~D13) ═════════
 * 상차 실적은 ASN과 독립된 차량 단위 문서다. 지시 상차는 상차지시서를 참조하고, 무지시 상차는 참조 없이 만든다.
 */

/// 상차 구분 — 지시(상차지시서 스캔) / 무지시(예정 외 차량, ASN 없음, D12)
enum LoadType {
  ORDERED
  UNORDERED
}

/// 상차 실적 상태 — 정의서 4-2
enum LoadStatus {
  WORKING // 작업중
  COMPLETED // 상차완료 (상차확인서 발행)
}

/// 상차 실적 (TB_LOAD_H) — 차량 1대 단위. 작업자 잠금 없음 (D11). 상차완료는 1회, 이후 입력 거부 (C6)
model Load {
  id             Int        @id @default(autoincrement())
  /// LD-YYYYMMDD-NNNN — 상차확인서 번호·바코드도 이 번호 (정의서 ④ "실적 번호 + 바코드")
  loadNo         String     @unique @map("load_no") @db.VarChar(20)
  loadType       LoadType   @map("load_type")
  /// 지시 상차만 — 상차지시서 1장에 상차 실적 1건
  loadOrderId    Int?       @unique @map("load_order_id")
  asnId          Int?       @unique @map("asn_id")
  clientId       Int        @map("client_id")
  centerId       Int        @map("center_id")
  /// 공백을 뺀 대문자 차량번호 (필수)
  vehicleNo      String     @map("vehicle_no") @db.VarChar(20)
  /// 상차하는 날 (KST) — 무지시 상차의 "당일 ASN 품목" 기준
  loadDate       DateTime   @map("load_dt") @db.Date
  status         LoadStatus @default(WORKING)
  /// 상차확인서 차수 — 상차 재개 때 +1, 확인서 번호는 그대로 (정의서 v1.5 D20)
  revisionNo     Int        @default(1) @map("revision_no")
  version        Int        @default(1)
  /// ASN 대비 차이 사유 (LOAD_DIFF 그룹, 기타는 텍스트 필수)
  diffReasonCode String?    @map("diff_reason_cd") @db.VarChar(20)
  diffReasonName String?    @map("diff_reason_nm") @db.VarChar(100)
  diffReasonText String?    @map("diff_reason_text") @db.VarChar(500)
  completeUserId Int?       @map("complete_user_id")
  completedBy    String?    @map("completed_by") @db.VarChar(50)
  completedAt    DateTime?  @map("complete_dt") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String     @map("created_by") @db.VarChar(50)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  loadOrder LoadOrder?  @relation(fields: [loadOrderId], references: [id], onDelete: Restrict)
  asn       Asn?        @relation(fields: [asnId], references: [id], onDelete: Restrict)
  client    Client      @relation(fields: [clientId], references: [id])
  center    Center      @relation(fields: [centerId], references: [id])
  lines     LoadLine[]
  inputs    LoadInput[]
  rcvs      Rcv[]
  histories LoadHistory[]

  @@index([clientId, status])
  @@index([centerId, loadDate])
  @@index([vehicleNo])
  @@map("tb_load_h")
}

/// 상차 품목별 합계 (TB_LOAD_D) — 입력 행 합계를 기준 단위로 모은다. 지시수량은 ASN 라인 합계
/// 상차 실적 처리 행위
enum LoadAction {
  COMPLETE // 상차완료 (상차확인서 발행)
  REOPEN // 상차 재개 (검수 시작 전, 사유 필수)
}

/// 상차 실적 처리 이력 (TB_LOAD_HIS) — 상차완료·재개를 차수와 함께 남긴다 (정의서 v1.5 D20). 무지시 상차는 ASN 이력이 없어 여기에만 남는다
model LoadHistory {
  id         Int        @id @default(autoincrement())
  loadId     Int        @map("load_id")
  action     LoadAction
  /// 처리한 시점의 상차확인서 차수
  revisionNo Int        @map("revision_no")
  actor      String     @db.VarChar(50)
  actorId    Int?       @map("actor_id")
  at         DateTime   @default(now()) @db.Timestamptz(3)
  reasonCode String?    @map("reason_cd") @db.VarChar(20)
  reasonName String?    @map("reason_nm") @db.VarChar(100)
  reasonText String?    @map("reason_text") @db.VarChar(500)

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@map("tb_load_his")
}

model LoadLine {
  id           Int @id @default(autoincrement())
  loadId       Int @map("load_id")
  itemId       Int @map("item_id")
  /// ASN 지시수량 합계 (기준 단위, 무지시·지시 외 품목은 0)
  orderBaseQty Int @default(0) @map("order_base_qty")
  /// 상차수량 합계 (기준 단위) = 취소되지 않은 입력 행의 합
  loadBaseQty  Int @default(0) @map("load_base_qty")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@unique([loadId, itemId])
  @@map("tb_load_d")
}

/// 상차 입력 행 (TB_LOAD_INPUT) — 입력 1건 = "추가로 실은 수량" 1행 (C5). 완료 전 본인 입력만 취소(정정)한다
model LoadInput {
  id          Int       @id @default(autoincrement())
  loadId      Int       @map("load_id")
  itemId      Int       @map("item_id")
  /// 스캔한 바코드의 단위 (손 입력은 기준 단위)
  unit        ItemUnit
  addQty      Int       @map("add_qty")
  baseQty     Int       @map("base_qty")
  /// 스캔·입력한 값 그대로
  scanned     String?   @db.VarChar(40)
  workerId    Int       @map("worker_id")
  workerName  String    @map("worker_nm") @db.VarChar(50)
  /// 단말 구분값 (단말 관리는 보류 — H2)
  deviceId    String?   @map("device_id") @db.VarChar(64)
  inputAt     DateTime  @default(now()) @map("input_dt") @db.Timestamptz(3)
  /// 지시수량 초과 경고를 보고 확인한 입력
  overConfirm Boolean   @default(false) @map("over_confirm")
  canceledAt  DateTime? @map("canceled_at") @db.Timestamptz(3)
  /// 정정으로 새로 넣은 행이면 원래 행
  correctsId  Int?      @map("corrects_id")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@index([loadId, inputAt])
  @@index([workerId])
  @@map("tb_load_input")
}

/**
 * ═════════ 입고검수 · 자동 배분 (정의서 ⑥ · 4-2 · 5장 · C7 · C8 · D14 · D15) ═════════
 * 검수 기준은 상차완료 차량 실적(상차확인서)이다. 차량 1대 = 검수 확정 1회.
 * 작업자 잠금 없음 (2026-11-05 Sol 결정, 미결 O1 → 상차와 같은 방식): 입력 1건 = 추가 수량 1행.
 */

/// 검수 상태 — 정의서 4-2 (입고취소 역전표는 4단계에서 추가)
enum RcvStatus {
  WORKING // 검수중
  CONFIRMED // 확정 (자동 배분 완료)
}

/// 검수 입력 구분 — 정상 / 훼손·오염 반송 / 품목 불일치 반송(상차 실적에 없는 품목)
enum RcvKind {
  GOOD
  DAMAGED
  MISMATCH
}

/// 배분 구분 — 정상 입고 누계(rcv_qty) / 반송 누계(return_qty)
enum RcvAllocKind {
  GOOD
  RETURN
}

/// 입고검수 헤더 (TB_RCV_H) — 상차완료 차량 실적 1건 기준
model Rcv {
  id             Int       @id @default(autoincrement())
  /// RC-YYYYMMDD-NNNN (검수 시작일)
  rcvNo          String    @unique @map("rcv_no") @db.VarChar(20)
  loadId         Int       @map("load_id")
  clientId       Int       @map("client_id")
  centerId       Int       @map("center_id")
  vehicleNo      String    @map("vehicle_no") @db.VarChar(20)
  /// 검수일 (KST)
  rcvDate        DateTime  @map("rcv_dt") @db.Date
  status         RcvStatus @default(WORKING)
  version        Int       @default(1)
  confirmUserId  Int?      @map("confirm_user_id")
  confirmedBy    String?   @map("confirmed_by") @db.VarChar(50)
  confirmedAt    DateTime? @map("confirm_dt") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String    @map("created_by") @db.VarChar(50)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  load   Load       @relation(fields: [loadId], references: [id], onDelete: Restrict)
  client Client     @relation(fields: [clientId], references: [id])
  center Center     @relation(fields: [centerId], references: [id])
  lines  RcvLine[]
  inputs RcvInput[]
  images RcvImage[]
  allocs RcvAlloc[]

  /// 입고취소 뒤 재검수를 위해 load_id 유일 제약은 두지 않는다 — 진행·확정 검수는 차량 실적당 1건(서비스에서 검사)
  @@index([loadId])
  @@index([centerId, rcvDate])
  @@index([clientId, status])
  @@map("tb_rcv_h")
}

/// 검수 품목별 합계 (TB_RCV_D) — 기대수량 = 상차완료 수량. 차이 = 정상 + 반송 − 기대 (C7)
model RcvLine {
  id            Int       @id @default(autoincrement())
  rcvId         Int       @map("rcv_id")
  itemId        Int       @map("item_id")
  /// 상차완료 수량 (기준 단위). 품목 불일치 라인은 0
  expectBaseQty Int       @default(0) @map("expect_base_qty")
  /// 정상 누계 (기준 단위)
  goodBaseQty   Int       @default(0) @map("good_base_qty")
  /// 훼손·오염 반송 누계 (기준 단위)
  damagedBaseQty Int      @default(0) @map("damaged_base_qty")
  /// 품목 불일치 반송 누계 (기준 단위) — 재고·배분 미반영
  mismatchBaseQty Int     @default(0) @map("mismatch_base_qty")
  /// 상차 실적에 없는 품목 (품목 불일치 라인)
  mismatch      Boolean   @default(false)
  /// 검수자가 확인하고 0으로 입력함 (D15 — "실제로 없었다"와 "검수를 빠뜨렸다" 구분)
  zeroConfirm   Boolean   @default(false) @map("zero_confirm_yn")
  reasonCode    String?   @map("reason_cd") @db.VarChar(20)
  reasonName    String?   @map("reason_nm") @db.VarChar(100)
  reasonText    String?   @map("reason_text") @db.VarChar(500)
  /// 관리 품목 — 입고예정 값과 다르면 현장 입력 (R8)
  expiryDate    DateTime? @map("expiry_dt") @db.Date
  lotNo         String?   @map("lot_no") @db.VarChar(40)

  rcv    Rcv        @relation(fields: [rcvId], references: [id], onDelete: Cascade)
  item   Item       @relation(fields: [itemId], references: [id])
  allocs RcvAlloc[]

  @@unique([rcvId, itemId])
  @@map("tb_rcv_d")
}

/// 검수 입력 행 (TB_RCV_INPUT) — 입력 1건 = 추가 수량 1행 (검수자·단말·시각). 확정 전 본인 입력만 취소·정정
model RcvInput {
  id         Int       @id @default(autoincrement())
  rcvId      Int       @map("rcv_id")
  itemId     Int       @map("item_id")
  kind       RcvKind
  unit       ItemUnit
  addQty     Int       @map("add_qty")
  baseQty    Int       @map("base_qty")
  scanned    String?   @db.VarChar(40)
  workerId   Int       @map("worker_id")
  workerName String    @map("worker_nm") @db.VarChar(50)
  deviceId   String?   @map("device_id") @db.VarChar(64)
  inputAt    DateTime  @default(now()) @map("input_dt") @db.Timestamptz(3)
  canceledAt DateTime? @map("canceled_at") @db.Timestamptz(3)
  correctsId Int?      @map("corrects_id")

  rcv  Rcv  @relation(fields: [rcvId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@index([rcvId, inputAt])
  @@index([workerId, inputAt])
  @@map("tb_rcv_input")
}

/// 훼손·오염 사진 (TB_RCV_IMAGE) — 품목당 최소 1장, 최대 5장. PDA에서 압축한 JPEG를 DB에 저장 (R7)
model RcvImage {
  id        Int      @id @default(autoincrement())
  rcvId     Int      @map("rcv_id")
  itemId    Int      @map("item_id")
  mime      String   @db.VarChar(40)
  size      Int
  data      Bytes
  createdBy String   @map("created_by") @db.VarChar(50)
  creatorId Int      @map("creator_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rcv Rcv @relation(fields: [rcvId], references: [id], onDelete: Cascade)

  @@index([rcvId, itemId])
  @@map("tb_rcv_image")
}

/// 자동 배분 결과 (TB_RCV_ALLOC) — (검수 라인, 입고예정 라인, 배분수량, 배분 단계). 3단계(초과)는 입고예정 라인 없음 (5-2 · C8)
model RcvAlloc {
  id         Int          @id @default(autoincrement())
  rcvId      Int          @map("rcv_id")
  rcvLineId  Int          @map("rcv_line_id")
  kind       RcvAllocKind
  /// 1: 원 ASN 라인 / 2: 같은 화주사 미종결 입고예정(승인 시각 순) / 3: 초과
  step       Int
  planLineId Int?         @map("plan_line_id")
  asnLineId  Int?         @map("asn_line_id")
  allocQty   Int          @map("alloc_qty")
  /// 입고취소 역전표로 되돌린 배분 (4단계)
  reverse    Boolean      @default(false) @map("reverse_yn")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  rcv      Rcv              @relation(fields: [rcvId], references: [id], onDelete: Cascade)
  rcvLine  RcvLine          @relation(fields: [rcvLineId], references: [id], onDelete: Cascade)
  planLine InboundPlanLine? @relation(fields: [planLineId], references: [id])
  asnLine  AsnLine?         @relation(fields: [asnLineId], references: [id])

  @@index([rcvId])
  @@index([planLineId])
  @@index([asnLineId])
  @@map("tb_rcv_alloc")
}
